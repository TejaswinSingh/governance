FROM golang:1.24.2 AS builder

# required for downloading private repos
RUN --mount=type=secret,id=github_token \
    GITHUB_TOKEN=$(cat /run/secrets/github_token) && \
    git config --global url."https://${GITHUB_TOKEN}:x-oauth-basic@github.com/".insteadOf "https://github.com/" && \
    echo "GOPRIVATE=github.com/Resolyte-official/*" >> /etc/environment && \
    echo "GOPROXY=direct" >> /etc/environment

WORKDIR /app

COPY go.mod go.sum ./

RUN go mod download

COPY . .

RUN CGO_ENABLED=0 go build -o governance ./cmd/

FROM alpine:3.21.3
WORKDIR /root/

COPY --from=builder /app/governance /root/
COPY --from=builder /app/configs /root/configs/

CMD ["/root/governance"]